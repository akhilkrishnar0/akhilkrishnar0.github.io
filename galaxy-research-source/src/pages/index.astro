---
import Base from '../layouts/Base.astro';
import {images} from '../data/images.js';
import {coverage,updates} from '../data/media.js';
import {url} from '../utils/path.js';
const tiles=[{title:'Research',description:'Galaxy structures, stellar populations and dynamics.',href:'research/',image:'prg1'},{title:'Biography',description:'Education, appointments and academic experience.',href:'biography/'},{title:'Conferences & Activities',description:'Talks, workshops and academic service.',href:'conferences/'},{title:'Photography',description:'A personal image archive, to be added.',href:'photography/'}];
---
<Base title="Home" description="Akhil Krishna R — research on galaxy structure, polar rings, low-surface-brightness galaxies and galaxy dynamics." image={images.hudf.src}>
<section class="hero"><img class="hero-image" src={images.hudf.src} alt={images.hudf.alt} fetchpriority="high"/><div class="hero-content container"><div class="eyebrow">Galaxy structure and evolution</div><h1>Why does the Universe produce such diverse galaxy structures?</h1><p class="lede">Galaxies exhibit a wide diversity of structures, including spiral arms, bars, rings, warped discs, and diffuse stellar components. These structures develop through gravitational dynamics, gas accretion, interactions and star formation. Understanding their formation and evolution is a central problem in galaxy evolution.</p></div><a class="hero-credit" href={images.hudf.source} target="_blank" rel="noopener noreferrer">{images.hudf.credit}</a></section>
<div class="container"><section class="lead-copy"><p class="lede">My research investigates galaxy structure and evolution using multiwavelength observations, stellar populations and numerical modelling, with emphasis on polar-ring galaxies, low-surface-brightness systems and disc dynamics.</p></section>
<section class="section"><div class="section-heading"><div class="eyebrow">Explore</div><h2>Research and academic activity</h2><p class="quiet">Brief descriptions of my research, academic activities, and other interests can be found through the links below.</p></div><div class="two-col">{tiles.map(t=><a class="home-tile" href={url(t.href)}><div class="tile-visual">{t.image?<img loading="lazy" src={images[t.image].src} alt={images[t.image].alt}/>:<span>{t.title==='Biography'?'Academic journey':'Photographs to be added'}</span>}</div><h3>{t.title} <span aria-hidden="true">↗</span></h3><p>{t.description}</p>{t.image&&<div class="tile-credit">{images[t.image].credit}</div>}</a>)}</div></section>
<section class="section"><div class="eyebrow">Selected updates</div><h2>Latest news</h2>{[updates[0],coverage[0],updates[1]].map(n=><article class="news-item"><div class="date"><time datetime={n.date}>{n.date}</time><div>{n.source||'Research update'}</div></div><div><h3><a href={n.href} target="_blank" rel="noopener noreferrer">{n.title} ↗</a></h3><p>{n.description}</p></div></article>)}<p style="margin-top:20px"><a class="subtle-link" href={url('news/')}>All news and media coverage ↗</a></p></section></div>
</Base>
