---
import Base from '../layouts/Base.astro';
import {coverage,updates} from '../data/media.js';
---
<Base title="News & Media" description="External news coverage and scientific research updates for Akhil Krishna R."><div class="container"><header class="page-header"><div class="eyebrow">Media and research milestones</div><h1>News & Media</h1><p class="lede">Selected externally published coverage and original publication announcements. Only traceable sources are included.</p></header><section class="section"><div class="eyebrow">Journalism and external coverage</div><h2>External media</h2>{coverage.map(n=><article class="news-item"><div class="date"><time datetime={n.date}>{n.date}</time><div>{n.source}</div></div><div><h3><a href={n.href} target="_blank" rel="noopener noreferrer">{n.title} ↗</a></h3><p>{n.description}</p></div></article>)}</section><section class="section"><div class="eyebrow">Peer-reviewed publications</div><h2>Research updates</h2>{updates.map(n=><article class="news-item"><div class="date"><time datetime={n.date}>{n.date}</time><div>Research publication</div></div><div><h3><a href={n.href} target="_blank" rel="noopener noreferrer">{n.title} ↗</a></h3><p>{n.description}</p></div></article>)}</section></div></Base>
