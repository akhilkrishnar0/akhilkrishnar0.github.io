---
import Base from '../layouts/Base.astro';
import {publications} from '../data/publications.js';
import {adsForDoi} from '../utils/path.js';
const items=[...publications].sort((a,b)=>b.year-a.year||(a.type==='first'?-1:1));
---
<Base title="Publications" description="Refereed scientific publications and preprints by Akhil Krishna R."><div class="container"><header class="page-header"><div class="eyebrow">Scientific record</div><h1>Publications</h1><p class="lede">Chronological bibliography compiled from the September 2026 CV and checked against available journal records. Preprints are labelled separately.</p></header><section class="section bibliography"><div class="bib-filter" role="group" aria-label="Filter publications"><button data-filter="all" aria-pressed="true">All publications</button><button data-filter="first" aria-pressed="false">First-author</button><button data-filter="co" aria-pressed="false">Co-authored</button><button data-filter="preprint" aria-pressed="false">Preprints</button></div><p class="quiet small" id="publication-count">{items.length} records, including preprints. Journal records have been checked; the preprint publication statuses should be reconfirmed before launch.</p><div id="bibliography">{items.map(p=><article data-type={p.type}><div class="eyebrow">{p.year} · {p.type==='first'?'First author':p.type==='co'?'Co-author':'Preprint'}</div><h3>{p.title}</h3><p>{p.authors}</p><p>{p.journal}</p><div class="inline-links">{p.doi&&<a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer">DOI</a>}{p.doi&&<a href={adsForDoi(p.doi)} target="_blank" rel="noopener noreferrer">NASA ADS</a>}{p.arxiv&&<a href={`https://arxiv.org/abs/${p.arxiv}`} target="_blank" rel="noopener noreferrer">arXiv</a>}{!p.verified&&<span class="quiet small">CV record · verify final metadata</span>}</div></article>)}</div></section></div></Base>
<script>
const buttons=[...document.querySelectorAll('[data-filter]')],entries=[...document.querySelectorAll('[data-type]')],count=document.querySelector('#publication-count');
buttons.forEach(b=>b.addEventListener('click',()=>{const f=b.dataset.filter;buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));let n=0;entries.forEach(e=>{const visible=f==='all'||e.dataset.type===f;e.hidden=!visible;if(visible)n++;});if(count)count.textContent=`${n} ${n===1?'record':'records'} shown. Preprints are labelled separately.`;}));
</script>
