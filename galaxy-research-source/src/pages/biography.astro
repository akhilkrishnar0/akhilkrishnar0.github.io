---
import Base from '../layouts/Base.astro';
import {url} from '../utils/path.js';
const timeline=[
 ['2025–Present','Postdoctoral Fellow','Indian Institute of Astrophysics, Bengaluru. Research on extended discs, ultraviolet star formation and galaxy evolution.'],
 ['2020–2025','Ph.D. in Physics','Christ University, Bengaluru. Thesis: Tracing the Evolution of Polar Ring Galaxies through Multi-wavelength Observations and Cosmological Simulations. Supervisor: Dr. Sreeja S. Kartha.'],
 ['2019–2020','Research Fellow','Christ University, Bengaluru. Research on ultraviolet upturn in early-type galaxies.'],
 ['2017–2019','M.Sc. in Physics','Christ University, Bengaluru. Thesis: UV Upturn in Early-Type Galaxies. Supervisor: Dr. Sreeja S. Kartha.'],
